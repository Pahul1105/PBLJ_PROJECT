<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- ============================================ -->
    <!-- Smart Student Management System              -->
    <!-- Web Application Deployment Descriptor         -->
    <!-- ============================================ -->

    <!-- Display Name (shown in Tomcat Manager) -->
    <display-name>Smart Student Management System</display-name>

    <!-- Welcome File: First page that loads when app starts -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- ============================================ -->
    <!-- SERVLET DECLARATIONS                         -->
    <!-- Maps servlet class names to internal names    -->
    <!-- ============================================ -->

    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.studentproject.servlet.LoginServlet</servlet-class>
    </servlet>

    <!-- Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.studentproject.servlet.LogoutServlet</servlet-class>
    </servlet>

    <!-- Add Student Servlet -->
    <servlet>
        <servlet-name>AddStudentServlet</servlet-name>
        <servlet-class>com.studentproject.servlet.AddStudentServlet</servlet-class>
    </servlet>

    <!-- View Student Servlet -->
    <servlet>
        <servlet-name>ViewStudentServlet</servlet-name>
        <servlet-class>com.studentproject.servlet.ViewStudentServlet</servlet-class>
    </servlet>

    <!-- Update Student Servlet -->
    <servlet>
        <servlet-name>UpdateStudentServlet</servlet-name>
        <servlet-class>com.studentproject.servlet.UpdateStudentServlet</servlet-class>
    </servlet>

    <!-- Delete Student Servlet -->
    <servlet>
        <servlet-name>DeleteStudentServlet</servlet-name>
        <servlet-class>com.studentproject.servlet.DeleteStudentServlet</servlet-class>
    </servlet>

    <!-- Search Student Servlet -->
    <servlet>
        <servlet-name>SearchStudentServlet</servlet-name>
        <servlet-class>com.studentproject.servlet.SearchStudentServlet</servlet-class>
    </servlet>

    <!-- ============================================ -->
    <!-- SERVLET URL MAPPINGS                         -->
    <!-- Maps URLs to servlet names                    -->
    <!-- ============================================ -->

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AddStudentServlet</servlet-name>
        <url-pattern>/addStudent</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>ViewStudentServlet</servlet-name>
        <url-pattern>/viewStudents</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>UpdateStudentServlet</servlet-name>
        <url-pattern>/updateStudent</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>DeleteStudentServlet</servlet-name>
        <url-pattern>/deleteStudent</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>SearchStudentServlet</servlet-name>
        <url-pattern>/searchStudent</url-pattern>
    </servlet-mapping>

    <!-- ============================================ -->
    <!-- SESSION CONFIGURATION                        -->
    <!-- Session timeout in minutes                    -->
    <!-- ============================================ -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- ============================================ -->
    <!-- ERROR PAGE CONFIGURATION                     -->
    <!-- Redirect to error.jsp on errors               -->
    <!-- ============================================ -->
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>

</web-app>
